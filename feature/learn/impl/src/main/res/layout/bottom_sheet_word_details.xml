<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:padding="@dimen/spacing_xl">

    <TextView
        android:id="@+id/wordOriginal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearanceHeadline1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Hello" />

    <TextView
        android:id="@+id/wordTranscription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearanceBody1Secondary"
        app:layout_constraintTop_toBottomOf="@+id/wordOriginal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="[həˈləʊ]" />

    <TextView
        android:id="@+id/wordTranslation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_base"
        android:textAppearance="@style/TextAppearanceHeadline3"
        app:layout_constraintTop_toBottomOf="@+id/wordTranscription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Привет" />

    <TextView
        android:id="@+id/examplesTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/learn_examples_title"
        android:textAppearance="@style/TextAppearanceLabel"
        app:layout_constraintTop_toBottomOf="@+id/wordTranslation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/wordExamples"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearanceBody1Secondary"
        app:layout_constraintTop_toBottomOf="@+id/examplesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Hello, how are you?\nПривет, как дела?" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarkAsKnown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:text="@string/learn_mark_as_known"
        style="@style/Widget.Grable.Button.Outlined.Small"
        app:layout_constraintTop_toBottomOf="@+id/wordExamples"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnDelete" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:layout_marginStart="@dimen/spacing_base"
        android:contentDescription="@string/learn_delete_word"
        app:icon="@drawable/ic_delete"
        app:iconTint="@color/error"
        android:textColor="@color/error"
        android:backgroundTint="@android:color/transparent"
        android:textAppearance="@style/TextAppearanceButtonSmall"
        app:layout_constraintTop_toBottomOf="@+id/wordExamples"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

